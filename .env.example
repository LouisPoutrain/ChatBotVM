# ==============================================================================
# VICTORIA RAG - Environment Variables Template
# Copy this file to `.env` and fill in your credentials before starting.
# ==============================================================================

# OpenAI-compatible LLM API credentials (e.g. ILaaS, Mistral, OpenAI, vLLM)
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://llm.ilaas.fr/v1

# Qdrant vector database URL (leave unset to use local embedded storage,
# or set to http://localhost:6333 locally / http://qdrant:6333 inside Docker Compose)
QDRANT_URL=http://localhost:6333

# Optional: UTBox / Nextcloud public share download URL for automated sync
UTBOX_SHARE_URL=
